<?xml version="1.0" encoding="utf-8"?>

<robot name="robot">
  <!-- ros2_control硬件接口配置 -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="wheel_0_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="wheel_1_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="wheel_2_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="wheel_3_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="mouth_Joint">
      <command_interface name="effort">
        <param name="min">-150.0</param>
        <param name="max">150.0</param>
      </command_interface>
    </joint>

    <joint name="dribble_Joint">
      <command_interface name="effort">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>
    </joint>
  </ros2_control>

  <!-- Gazebo仿真配置模块 -->
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>/home/yixi/ROS/zjunlict/src/robot/config/controller_manager.yaml</parameters>
    </plugin>
    <robotNamespace>/</robotNamespace>
    
    <!-- 全局碰撞禁用：仅保留车轮碰撞 -->
    <disable_collisions link1="base_Link" link2="*" />
    <disable_collisions link1="mouth_Link" link2="*" />
    <disable_collisions link1="dribble_Link" link2="*" />
  </gazebo>

  <!-- 基础车身链接（完全无碰撞） -->
  <link name="base_Link">
    <!-- 惯性参数完全保留原值 -->
    <inertial>
      <origin xyz="-0.0098481 5.9245E-07 0.010215" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.0004144" ixy="0.00000001849" ixz="0.0000007185"
               iyy="0.0003855" iyz="0.00000000001813" izz="0.0007036" />
    </inertial>

    <!-- 视觉模型完全保留原值 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/base_Link.STL" />
      </geometry>
      <material name="base_material">
        <color rgba="1 0 0 1" />
      </material>
    </visual>

    <!-- 车身完全无碰撞配置 -->
    <gazebo reference="base_Link">
      <material>Gazebo/Red</material>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <!-- 车轮0链接（仅修改摩擦参数，其余完全保留） -->
  <link name="wheel_0_Link">
    <!-- 惯性参数完全保留原值 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>

    <!-- 视觉模型完全保留原值 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_0_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>

    <!-- 碰撞体完全保留原值（仅车轮有碰撞） -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>

    <!-- Gazebo物理参数：仅添加/修改滚动/旋转摩擦，其余保留原值 -->
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp> <!-- 刚度：1e6，保证轮子不陷地 -->
      <kd>10.0</kd>      <!-- 阻尼：防止接触震荡 -->
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>    <!-- 新增：滚动摩擦 -->
      <rotational_friction>0</rotational_friction>  <!-- 新增：旋转摩擦 -->
    </gazebo>
    <gazebo reference="wheel_0_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮0关节（优化角度精度+修改关节阻尼/摩擦） -->
  <joint name="wheel_0_Joint" type="continuous">
    <origin xyz="0.041864 0.066996 0.0225" rpy="0 0 -0.55851" />
    <parent link="base_Link" />
    <child link="wheel_0_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />  <!-- 修改：关节阻尼+摩擦 -->
  </joint>

  <!-- 车轮1链接（与车轮0参数完全一致） -->
  <link name="wheel_1_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_1_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp> <!-- 刚度：1e6，保证轮子不陷地 -->
      <kd>10.0</kd>      <!-- 阻尼：防止接触震荡 -->
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>    <!-- 新增：滚动摩擦 -->
      <rotational_friction>0</rotational_friction>  <!-- 新增：旋转摩擦 -->
    </gazebo>
    <gazebo reference="wheel_1_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮1关节（优化角度精度+修改关节阻尼/摩擦） -->
  <joint name="wheel_1_Joint" type="continuous">
    <origin xyz="0.041864 -0.066996 0.0225" rpy="0 0 -2.5831" />
    <parent link="base_Link" />
    <child link="wheel_1_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮2链接（与车轮0参数完全一致） -->
  <link name="wheel_2_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_2_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp> <!-- 刚度：1e6，保证轮子不陷地 -->
      <kd>10.0</kd>      <!-- 阻尼：防止接触震荡 -->
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>    <!-- 新增：滚动摩擦 -->
      <rotational_friction>0</rotational_friction>  <!-- 新增：旋转摩擦 -->
    </gazebo>
    <gazebo reference="wheel_2_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮2关节（优化角度精度+修改关节阻尼/摩擦） -->
  <joint name="wheel_2_Joint" type="continuous">
    <origin xyz="-0.055861 -0.055861 0.0225" rpy="0 0 2.3562" />
    <parent link="base_Link" />
    <child link="wheel_2_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮3链接（与车轮0参数完全一致） -->
  <link name="wheel_3_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_3_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp> <!-- 刚度：1e6，保证轮子不陷地 -->
      <kd>10.0</kd>      <!-- 阻尼：防止接触震荡 -->
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>    <!-- 新增：滚动摩擦 -->
      <rotational_friction>0</rotational_friction>  <!-- 新增：旋转摩擦 -->
    </gazebo>
    <gazebo reference="wheel_3_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮3关节（优化角度精度+修改关节阻尼/摩擦） -->
  <joint name="wheel_3_Joint" type="continuous">
    <origin xyz="-0.055861 0.055861 0.0225" rpy="0 0 0.7854" />
    <parent link="base_Link" />
    <child link="wheel_3_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 机械臂/嘴巴链接（完全无碰撞） -->
  <link name="mouth_Link">
    <inertial>
      <origin xyz="0.0061665 -0.041178 0.033013" rpy="0 0 0" />
      <mass value="0.20952" />
      <inertia ixx="4.8361E-05" ixy="-3.4805E-08" ixz="-1.004E-07"
               iyy="1.5441E-05" iyz="2.5967E-08" izz="4.7443E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/mouth_Link.STL" />
      </geometry>
      <material name="mouth_material">
        <color rgba="0 0 1 1" />
      </material>
    </visual>
    <gazebo reference="mouth_Link">
      <material>Gazebo/Blue</material>
      <damping>0.2</damping>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <!-- 机械臂关节（完全保留原值） -->
  <joint name="mouth_Joint" type="revolute">
    <origin xyz="0.0519 0.04365 0.0113" rpy="0 0 0" />
    <parent link="base_Link" />
    <child link="mouth_Link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.16" effort="150" velocity="0.8" />
  </joint>

  <!-- 运球机构链接（完全无碰撞） -->
  <link name="dribble_Link">
    <inertial>
      <origin xyz="2.2549E-05 0.0019168 0.00014443" rpy="0 0 0" />
      <mass value="0.017857" />
      <inertia ixx="7.3784E-06" ixy="-7.9042E-10" ixz="1.8567E-10"
               iyy="2.5482E-07" iyz="-3.6986E-09" izz="7.3795E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/dribble_Link.STL" />
      </geometry>
      <material name="dribble_material">
        <color rgba="0 1 0 1" />
      </material>
    </visual>
    <gazebo reference="dribble_Link">
      <material>Gazebo/Green</material>
      <damping>0.1</damping>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <!-- 运球机构关节（完全保留原值） -->
  <joint name="dribble_Joint" type="continuous">
    <origin xyz="0.015669 -0.0459 0.027271" rpy="0 -0.18761 0" />
    <parent link="mouth_Link" />
    <child link="dribble_Link" />
    <axis xyz="0 -1 0" />
  </joint>

</robot>
