<sdf version='1.7'>
    <world name='hard_carpet_world'>

        <physics type="ode">
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>500</iters>
                    <sor>1.6</sor>
                    <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
                </solver>
                <constraints>
                    <cfm>5e-4</cfm>                <!-- 约束力混合参数，增加数值柔韧性 -->
                    <erp>0.2</erp>                 <!-- 误差减少参数，提高约束满足速度 -->
                </constraints>
                <!-- <friction_model>cone_model</friction_model> -->
            </ode>

            <real_time_factor>0.04</real_time_factor>
            <real_time_update_rate>200</real_time_update_rate>
            <max_step_size>0.0001</max_step_size>
        </physics>

        <plugin name='GazeboPlugin'
            filename='/home/dream/matlab/GazeboPlugin/export/lib/libGazeboCoSimPlugin.so'>
            <portNumber>14582</portNumber>
            <protocol>udp</protocol>
        </plugin>
        <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        <model name='ground_plane'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>90 120</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>10</mu>
                                <mu2>10</mu2>
                                <slip1>0.01</slip1>
                                <slip2>0.01</slip2>
                            </ode>
                        </friction>
                        <contact>
                            <ode>
                                <kp>50000</kp>
                                <kd>50</kd>
                                <min_depth>0.0005</min_depth>
                            </ode>
                        </contact>
                    </surface>
                </collision>
                <visual name='visual'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>90 120</size>
                        </plane>
                    </geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Grey</name>
                        </script>
                    </material>
                </visual>
            </link>
        </model>
        <model name='north_wall'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>90 0.2 5</size>
                        </box>
                    </geometry>
                </collision>
            </link>
            <pose>0 60 2.5 0 -0 0</pose>
        </model>
        <model name='south_wall'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>90 0.2 5</size>
                        </box>
                    </geometry>
                </collision>
            </link>
            <pose>0 -60 2.5 0 -0 0</pose>
        </model>
        <model name='west_wall'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.2 120 5</size>
                        </box>
                    </geometry>
                </collision>
            </link>
            <pose>-45 0 2.5 0 -0 0</pose>
        </model>
        <model name='east_wall'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.2 120 5</size>
                        </box>
                    </geometry>
                </collision>
            </link>
            <pose>45 0 2.5 0 -0 0</pose>
        </model>
        <gravity>0 0 -9.8</gravity>
        <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
        <atmosphere type='adiabatic' />
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>1</shadows>
        </scene>
    </world>
</sdf>
